<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="search_sirene_result_form">
        <field name="name">search.sirene.result.form</field>
        <field name="model">search.sirene.result</field>
        <field name="arch" type="xml">
            <form string="SIRENE Search Result">
                <header>
                    <button name="action_update_record" string="Create"
                            type="object" class="btn btn-primary" icon="fa-check"/>
                    <button name="action_enrich_record" string="Enrich"
                            type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" class="text-break" default_focus="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="partner_type"/>
                        <field name="siret"/>
                        <field name="siren"/>
                        <field name="naf_id"/>
                        <field name="creation_date"/>
                        <field name="country_id"/>
                    </group>

                    <notebook>
                        <page string="Address" name="address">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="zip"/>
                                    <field name="city"/>
                                </group>
                            </group>
                        </page>

                        <page string="AI Data" name="ai_data">
                            <group>
                                <group>
                                    <field name="web_description"/>
                                    <field name="web_category"/>
                                    <field name="linkedin_url" widget="url"/>
                                    <field name="website" widget="url"/>
                                </group>
                                <group>
                                    <field name="data_enriched" groups="base.group_no_one"/>
                                    <field name="web_search_result" groups="base.group_no_one"/>
                                </group>
                            </group>
                        </page>

                        <page string="Financial Data" name="financial_data">
                            <group>
                                <group>
                                    <button name="action_get_inpi_company_data" string="Get INPI datas"
                                            type="object" class="oe_highlight"/>
                                </group>
                            </group>
                            <group>
                                <group name="financial_data_left" class="o_group_insee_details">
                                    <field name="workforce_range"/>
                                    <field name="turnover"/>
                                    <field name="capital"/>
                                    <field name="net_result"/>
                                    <field name="debt_rate"/>
                                    <field name="gross_margin"/>
                                </group>
                                <group name="financial_data_right" class="o_group_insee_details">
                                    <field name="fiscal_year_closing_date"/>
                                    <field name="company_object"/>
                                    <field name="owners"/>
                                </group>
                            </group>
                            <group col="1">
                                <button name="action_get_inpi_company_attachments" type="object"
                                        class="btn btn-primary" icon="fa-refresh"
                                        string="Get INPI Attachments"/>
                                <label for="inpi_attachment_ids" string="Documents"/>
                                <field name="inpi_attachment_ids" nolabel="1">
                                    <list string="Attachments">
                                        <field name="attachment_date" string="Date"/>
                                        <field name="name"/>
                                        <field name="type"/>
                                        <button name="download_inpi_attachment" type="object"
                                                icon="fa-download" string="Download"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Financial Ratios" name="financial_ratios">
                            <group>
                                <group>
                                    <button name="action_get_financial_ratios" string="Get Financial Ratios"
                                            type="object" class="oe_highlight"/>
                                </group>
                            </group>
                            <group>
                                <group name="financial_ratios_left_top" class="o_group_insee_details">
                                    <field name="ebe"/>
                                    <field name="ebit"/>
                                    <field name="marge_ebe"/>
                                    <field name="caf_sur_ca"/>
                                </group>
                                <group name="financial_ratios_right_top" class="o_group_insee_details">
                                    <field name="ratio_de_vetuste"/>
                                    <field name="ratio_de_liquidite"/>
                                    <field name="autonomie_financiere"/>
                                    <field name="credit_clients_jours"/>
                                </group>
                                <group name="financial_ratios_left_bottom" class="o_group_insee_details">
                                    <field name="couverture_des_interets"/>
                                    <field name="capacite_de_remboursement"/>
                                    <field name="credit_fournisseurs_jours"/>
                                    <field name="rotation_des_stocks_jours"/>
                                </group>
                                <group name="financial_ratios_right_bottom" class="o_group_insee_details">
                                    <field name="poids_bfr_exploitation_sur_ca"/>
                                    <field name="poids_bfr_exploitation_sur_ca_jours"/>
                                    <field name="resultat_courant_avant_impots_sur_ca"/>
                                </group>
                            </group>
                        </page>

                        <page string="Raw Data" name="raw_data" groups="base.group_no_one">
                            <group>
                                <field name="values" nolabel="1"/>
                                <field name="sirene_json_values" widget="jsonb"/>
                                <field name="opendata_json_values" widget="jsonb"/>
                                <field name="inpi_json_values" widget="jsonb"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="search_sirene_result_tree">
        <field name="name">search.sirene.result.tree</field>
        <field name="model">search.sirene.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="siret"/>
                <field name="siren"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="creation_date"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="search_sirene_result_search">
        <field name="name">search.sirene.result.search</field>
        <field name="model">search.sirene.result</field>
        <field name="arch" type="xml">
            <search string="Search SIRENE Results">
                <field name="name"/>
                <field name="siret"/>
                <field name="siren"/>
                <field name="city"/>
                <field name="country_id"/>
                <filter string="Enriched Data" name="data_enriched" domain="[('data_enriched', '=', True)]"/>
                <group>
                    <filter string="Partner Type" name="partner_type" context="{'group_by':'partner_type'}"/>
                    <filter string="Country" name="country_id" context="{'group_by':'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_search_sirene_result">
        <field name="name">SIRENE Search Results</field>
        <field name="res_model">search.sirene.result</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SIRENE search results found. Start a new search to see results here.
            </p>
        </field>
    </record>
</odoo>
