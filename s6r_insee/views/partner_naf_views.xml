<odoo>
    <record id="partner_naf_view_form" model="ir.ui.view">
        <field name="name">NAF APE</field>
        <field name="model">partner.naf</field>
        <field name="arch" type="xml">
            <form string="NAF APE">
                <sheet>
                    <group col="4">
                        <field name="naf_code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_naf_view_tree" model="ir.ui.view">
        <field name="name">NAF APE</field>
        <field name="model">partner.naf</field>
        <field eval="6" name="priority"/>
        <field name="arch" type="xml">
            <list string="NAF APE">
                <field name="naf_code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="partner_naf_view_search" model="ir.ui.view">
        <field name="name">partner.naf.view.search</field>
        <field name="model">partner.naf</field>
        <field name="arch" type="xml">
            <search string="Search Partner NAF APE">
                <field name="name"/>
                <field name="naf_code"/>
            </search>
        </field>
    </record>

    <record id="partner_naf_action" model="ir.actions.act_window">
        <field name="name">NAF APE Codes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.naf</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="partner_naf_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new NAF APE Code
            </p>
        </field>
    </record>

    <record id="action_import_naf_codes" model="ir.actions.server">
        <field name="name">Import NAF Codes</field>
        <field name="model_id" ref="model_partner_naf"/>
        <field name="binding_model_id" ref="model_partner_naf"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = model.import_naf_list()
        </field>
    </record>

    <menuitem id="partner_naf_menu" name="NAF APE Codes"
              action="partner_naf_action"
              parent="contacts.res_partner_menu_config"
              sequence="98"/>
    <menuitem id="import_naf_codes_menu" name="Import NAF Codes"
              action="action_import_naf_codes"
              parent="contacts.res_partner_menu_config"
              sequence="99"/>
</odoo>
