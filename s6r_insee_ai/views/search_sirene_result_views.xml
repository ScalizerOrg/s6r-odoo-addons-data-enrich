<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_search_sirene_result_form_inherit" model="ir.ui.view">
        <field name="name">search.sirene.result.form.inherit</field>
        <field name="model">search.sirene.result</field>
        <field name="inherit_id" ref="s6r_insee.search_sirene_result_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="email"/>
                <field name="phone"/>
            </xpath>
        </field>
    </record>
</odoo>
